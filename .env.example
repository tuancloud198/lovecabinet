SECRET_KEY=local-development-change-this-to-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=lovecabinet
POSTGRES_USER=lovecabinet
POSTGRES_PASSWORD=local-postgres-password
MINIO_ACCESS_KEY=lovecabinet
MINIO_SECRET_KEY=local-minio-password
MINIO_BUCKET=memories
APP_PORT=8080

# "Sign in with Google": OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# Add http://localhost:8080 (and http://localhost:5173 for vite dev) as Authorized JavaScript origins.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=484125370326-08htkdbt7ialbfpd5nce8ekedir7t52s.apps.googleusercontent.com

# Temporary proxy for docker builds only (leave empty if not behind a proxy)
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1
# Proxy for the backend's outbound HTTPS at runtime (Google sign-in verification). Leave empty
# when the backend can reach the internet directly.
RUNTIME_HTTPS_PROXY=

# Reverse proxies in front of Django (compose: the frontend nginx)
TRUSTED_PROXY_COUNT=1
